---
import { Picture } from "astro:assets";
import { services } from "../data/site-content";
---

<section class="section services legacy-fragment-target" id="servicios" aria-labelledby="services-title">
  <span id="productsAndServices" class="legacy-fragment-alias" aria-hidden="true"></span>
  <div class="container editorial-heading">
    <div>
      <p class="eyebrow">Servicios</p>
      <h2 id="services-title">Tecnología aplicada a una necesidad concreta</h2>
    </div>
    <div>
      <p>
        Podemos construir una solución, revisar decisiones técnicas, sumar capacidad a un equipo o
        acompañar el desarrollo de un producto SaaS.
      </p>
      <a class="text-link" href="/servicios/">Conocé cómo trabajamos <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="container service-cards">
    {services.map((service) => (
      <article class:list={["service-card", { "legacy-fragment-target": service.legacyAlias }]} id={service.id}>
        {service.legacyAlias && (
          <span id={service.legacyAlias} class="legacy-fragment-alias" aria-hidden="true"></span>
        )}
        <div class="service-card-media">
          <Picture
            src={service.image}
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[360, 560, 720]}
            sizes="(min-width: 960px) 540px, calc(100vw - 40px)"
            alt={service.imageAlt}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="service-card-copy">
          <span class="service-number">{service.number}</span>
          <h3>{service.title}</h3>
          <p>{service.shortDescription}</p>
          <a class="text-link" href={service.href}>Ver más <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </div>
</section>
