---
import { Picture } from "astro:assets";
import { about, site } from "../data/site-content";
---

<section class="section about legacy-fragment-target" id="nosotros" aria-labelledby="about-title">
  <span id="aboutUs" class="legacy-fragment-alias" aria-hidden="true"></span>
  <div class="container about-editorial">
    <div class="about-media">
      <Picture
        src={about.image}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[480, 720, 960]}
        sizes="(min-width: 900px) 520px, calc(100vw - 40px)"
        alt={about.imageAlt}
        loading="lazy"
        decoding="async"
      />
      <p>{site.address}<br />{site.locality}</p>
    </div>

    <div class="about-content">
      <p class="eyebrow">Nosotros</p>
      <h2 id="about-title">Un equipo de Salta para conversar, decidir y construir</h2>
      <p>{about.summary}</p>
      <ul class="about-principles">
        {about.principles.map((principle, index) => (
          <li>
            <span>0{index + 1}</span>
            <div><strong>{principle.title}</strong><p>{principle.copy}</p></div>
          </li>
        ))}
      </ul>
      <a class="text-link" href="/nosotros/">Conocé más sobre SaltaCode <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
