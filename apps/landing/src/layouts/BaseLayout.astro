---
import "../styles/global.css";
import PrivacyCenter from "../components/PrivacyCenter.astro";
import { site } from "../data/site-content";

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  breadcrumbs?: readonly Breadcrumb[];
  schema?: readonly Record<string, unknown>[];
}

const { title, description, indexable = true, breadcrumbs = [], schema = [] } = Astro.props;

if (!Astro.site) {
  throw new Error("Astro site must be configured to generate canonical metadata.");
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/images/social/saltacode-social.webp", Astro.site);
const organizationId = new URL("/#organization", Astro.site);
const websiteId = new URL("/#website", Astro.site);
const webpageId = new URL(`${Astro.url.pathname}#webpage`, Astro.site);

const graph: Record<string, unknown>[] = [
  {
    "@type": ["Organization", "ProfessionalService"],
    "@id": organizationId.href,
    name: site.name,
    legalName: site.legalName,
    taxID: site.taxId,
    url: Astro.site.href,
    logo: new URL("/favicon.png", Astro.site).href,
    email: site.email,
    telephone: site.phoneDisplay,
    founder: { "@type": "Person", name: site.legalName },
    address: {
      "@type": "PostalAddress",
      streetAddress: site.address,
      addressLocality: site.addressLocality,
      addressRegion: site.addressRegion,
      addressCountry: site.addressCountry,
    },
    sameAs: site.social.map(({ href }) => href),
  },
  {
    "@type": "WebSite",
    "@id": websiteId.href,
    url: Astro.site.href,
    name: site.name,
    publisher: { "@id": organizationId.href },
    inLanguage: "es-AR",
  },
  {
    "@type": "WebPage",
    "@id": webpageId.href,
    url: canonicalUrl.href,
    name: title,
    description,
    isPartOf: { "@id": websiteId.href },
    about: { "@id": organizationId.href },
    inLanguage: "es-AR",
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: new URL(item.path, Astro.site).href,
    })),
  });
}

graph.push(...schema);

const structuredData = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable
        ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        : "noindex, follow"}
    />
    {indexable && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SaltaCode" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tarjeta de SaltaCode Innovación y Desarrollo" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Tarjeta de SaltaCode Innovación y Desarrollo" />

    <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline data-theme-bootstrap>
      (()=>{let p="system";try{const s=localStorage.getItem("saltacode-theme");if(s==="light"||s==="dark")p=s}catch{}const t=p==="system"?(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"):p,m=matchMedia("(prefers-reduced-motion: reduce)").matches,r=document.documentElement;r.dataset.theme=t;r.dataset.themePreference=p;r.style.colorScheme=t;document.querySelector('meta[name="theme-color"]')?.setAttribute("content",t==="dark"?"#111016":"#ffffff");const i=e=>{const s=m?(t==="dark"?e.dataset.themeSrcReducedDark:e.dataset.themeSrcReducedLight):null,f=s||(t==="dark"?e.dataset.themeSrcDark:e.dataset.themeSrcLight);if(f)e.src=f},a=n=>{if(n.nodeType!==1)return;if(n.matches("[data-theme-image]"))i(n);n.querySelectorAll("[data-theme-image]").forEach(i)},o=new MutationObserver(m=>m.forEach(x=>x.addedNodes.forEach(a)));o.observe(r,{childList:true,subtree:true});addEventListener("DOMContentLoaded",()=>o.disconnect(),{once:true})})();
    </script>
    {indexable && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <slot />
    <PrivacyCenter />
    <script>
      import "../scripts/theme-controller";
    </script>
  </body>
</html>
