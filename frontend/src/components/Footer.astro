---
import { brandImages } from "../data/image-assets";
import { services, site } from "../data/site-content";
import ThemeImage from "./ThemeImage.astro";
import SiteIcon from "./SiteIcon.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-callout">
    <p class="eyebrow">¿Tenés un proyecto en mente?</p>
    <h2>Conversemos sobre el punto de partida</h2>
    <a class="button" href="/contacto/">Contactar a SaltaCode</a>
  </div>

  <div class="container footer-main">
    <div class="footer-intro">
      <a class="brand footer-brand" href="/" aria-label="SaltaCode, volver al inicio">
        <ThemeImage variants={brandImages.lockup} width={320} alt="" loading="lazy" decoding="async" />
      </a>
      <p>Software a medida, consultoría y equipos IT desde Salta, Argentina.</p>
    </div>

    <nav aria-label="Servicios en el pie">
      <strong>Servicios</strong>
      <ul class="footer-links">
        {services.map((service) => <li><a href={service.href}>{service.title}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="SaltaCode en el pie">
      <strong>SaltaCode</strong>
      <ul class="footer-links">
        <li><a href="/#clientes">Clientes</a></li>
        <li><a href="/nosotros/">Nosotros</a></li>
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </nav>

    <nav aria-label="Información legal en el pie">
      <strong>Legal</strong>
      <ul class="footer-links">
        <li><a href="/legal/privacidad/">Privacidad</a></li>
        <li><a href="/legal/cookies/">Cookies y almacenamiento</a></li>
        <li><a href="/legal/terminos/">Términos de uso</a></li>
        <li><a href="/legal/cookies/" data-privacy-settings>Preferencias de privacidad</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <div>
      <small>© {year} SaltaCode.</small>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <ul class="footer-social" aria-label="Redes sociales">
      {site.social.map((social) => (
        <li><a href={social.href} target="_blank" rel="noopener noreferrer"><SiteIcon name={social.icon} /> {social.name}</a></li>
      ))}
    </ul>
  </div>
</footer>
