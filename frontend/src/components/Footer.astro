---
import { brandImages } from "../data/image-assets";
import ThemeImage from "./ThemeImage.astro";

interface Props {
  homePath?: "" | "/";
}

const { homePath = "" } = Astro.props;
const homeFragment = (id: string) => `${homePath}#${id}`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href={homeFragment("top")} aria-label="SaltaCode, volver al inicio">
        <ThemeImage
          variants={brandImages.mark}
          width={34}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span>SaltaCode</span>
      </a>
      <p>
        Empresa tecnológica integral: desarrollo de software, consultoría IT, outsourcing de equipos
        y soluciones bajo el modelo SaaS.
      </p>
    </div>

    <nav aria-label="Navegación del pie">
      <ul>
        <li><a href={homeFragment("clientes")}>Nuestros clientes</a></li>
        <li><a href={homeFragment("servicios")}>Servicios y productos</a></li>
        <li><a href={homeFragment("nosotros")}>Nosotros</a></li>
        <li><a href={homeFragment("contacto")}>Contactanos</a></li>
      </ul>
    </nav>

    <div>
      <strong>Contacto</strong>
      <a href="mailto:saltacodear@gmail.com">saltacodear@gmail.com</a>
      <span>Zuviría 333, Oficina 4C</span>
      <small>© {year} SaltaCode</small>
    </div>
  </div>
</footer>
