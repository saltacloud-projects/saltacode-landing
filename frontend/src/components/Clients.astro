---
import { clients } from "../data/image-assets";
import ThemeImage from "./ThemeImage.astro";
---

<section class="section clients legacy-fragment-target" id="clientes" aria-labelledby="clients-title">
  <span id="ourCustomers" class="legacy-fragment-alias" aria-hidden="true"></span>
  <div class="container section-heading centered">
    <p class="eyebrow">Nuestros clientes</p>
    <h2 id="clients-title">Nuestros clientes</h2>
  </div>

  <ul class="container client-list" aria-label="Clientes de SaltaCode">
    {clients.map((client) => (
      <li>
        <ThemeImage
          variants={client.logo}
          width={180}
          height={80}
          alt={`Logo de ${client.name}`}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>
</section>
