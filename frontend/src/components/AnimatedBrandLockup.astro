---
import lockupOnDark from "../assets/brand/animated-lockup-onDark.svg?url";
import lockupOnLight from "../assets/brand/animated-lockup-onLight.svg?url";
import staticLockupOnDark from "../assets/brand/static-lockup-onDark.svg?url";
import staticLockupOnLight from "../assets/brand/static-lockup-onLight.svg?url";
---

<img
  class="hero-brand"
  data-hero-brand
  data-theme-image
  data-theme-src-light={lockupOnLight}
  data-theme-src-dark={lockupOnDark}
  data-theme-src-reduced-light={staticLockupOnLight}
  data-theme-src-reduced-dark={staticLockupOnDark}
  width="370"
  height="152"
  alt=""
  aria-hidden="true"
  loading="eager"
  decoding="sync"
/>
