---
import AnimatedBrandLockup from "./AnimatedBrandLockup.astro";
import Clients from "./Clients.astro";

const circuitPaths = [
  {
    name: "upper",
    path: "M 50 155 H 230 L 330 255 H 500 L 620 375 H 980 L 1100 255 H 1270 L 1370 155 H 1550",
    core: false,
  },
  {
    name: "middle",
    path: "M 0 410 H 260 L 360 510 H 520 L 650 380 H 950 L 1080 510 H 1240 L 1340 410 H 1600",
    core: false,
  },
  {
    name: "lower",
    path: "M 100 720 H 280 L 400 600 H 540 L 680 460 H 920 L 1060 600 H 1200 L 1320 720 H 1500",
    core: false,
  },
  {
    name: "crown",
    path: "M 340 0 V 110 L 480 250 H 620 L 710 340 H 890 L 980 250 H 1120 L 1260 110 V 0",
    core: false,
  },
  {
    name: "left-branch",
    path: "M 0 285 H 150 L 290 425 H 460 L 610 575 H 720 L 800 495",
    core: false,
  },
  {
    name: "right-branch",
    path: "M 800 495 L 880 575 H 990 L 1140 425 H 1310 L 1450 285 H 1600",
    core: false,
  },
  {
    name: "core",
    path: "M 800 0 V 150 L 735 215 V 315 L 800 380 V 520 L 735 585 V 760",
    core: true,
  },
] as const;

const circuitNodes = [
  { path: "upper", duration: 20, delay: -3 },
  { path: "upper", duration: 20, delay: -13 },
  { path: "middle", duration: 16, delay: -7 },
  { path: "lower", duration: 22, delay: -5 },
  { path: "crown", duration: 18, delay: -9 },
  { path: "left-branch", duration: 19, delay: -4 },
  { path: "right-branch", duration: 19, delay: -12 },
  { path: "core", duration: 17, delay: -2 },
  { path: "core", duration: 17, delay: -10.5 },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-network" data-hero-motion aria-hidden="true">
    <svg viewBox="0 0 1600 760" width="1600" height="760" focusable="false">
      {circuitPaths.map(({ name, path, core }) => (
        <path
          data-circuit-path={name}
          class:list={["hero-circuit-path", { "hero-circuit-path-core": core }]}
          d={path}
        ></path>
      ))}
    </svg>
    {circuitNodes.map(({ path, duration, delay }) => (
      <span
        class="hero-circuit-node"
        data-circuit-node={path}
        data-duration={duration}
        data-delay={delay}
      ></span>
    ))}
  </div>

  <div class="container hero-inner">
    <AnimatedBrandLockup />
    <h1 id="hero-title">Software a medida <span>para tu empresa</span></h1>
    <p class="hero-copy">
      Diseñamos sistemas, integramos herramientas y sumamos equipos IT para resolver necesidades
      concretas de tu negocio.
    </p>

    <form
      class="agent-preview"
      data-chat-launcher
    >
      <span class="agent-symbol" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
          <path d="M12 3.5c.7 4.4 2.1 5.8 6.5 6.5-4.4.7-5.8 2.1-6.5 6.5-.7-4.4-2.1-5.8-6.5-6.5 4.4-.7 5.8-2.1 6.5-6.5Z"></path>
          <path d="M18.4 15.8c.3 1.8.9 2.4 2.6 2.7-1.7.3-2.3.9-2.6 2.5-.3-1.6-.9-2.2-2.6-2.5 1.7-.3 2.3-.9 2.6-2.7Z"></path>
        </svg>
      </span>
      <label class="visually-hidden" for="agent-question">¿Qué necesitás resolver?</label>
      <input
        class="agent-input"
        id="agent-question"
        name="question"
        type="text"
        maxlength="280"
        autocomplete="off"
        enterkeyhint="send"
        aria-describedby="agent-helper"
        placeholder="¿Qué necesitás resolver en tu empresa?"
      />
      <button class="agent-send" type="submit" aria-label="Abrir chat con el asistente">
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" focusable="false">
          <path d="m4 5 16-2-6.8 17-2.4-6.8L4 10.5 4 5Zm7.2 6.3 5-5.1-8.8 2 4 1.6-.2 1.5Z"></path>
        </svg>
      </button>
    </form>
    <p class="agent-helper" id="agent-helper">
      Contanos el contexto y te orientamos sobre el servicio y el próximo paso.
    </p>

    <nav class="quick-links" aria-label="Accesos rápidos a servicios">
      <a href="#software-factory">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"></path>
        </svg>
        Software a medida
      </a>
      <a href="#consultoria-it">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM2 21v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2M16 8h6M19 5v6M17 14h3a3 3 0 0 1 3 3v4"></path>
        </svg>
        Consultoría IT
      </a>
      <a href="#soluciones-saas">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7 18H5a4 4 0 0 1-.4-8A7 7 0 0 1 18 8.5 4.8 4.8 0 0 1 1 9.5A4.3 4.3 0 0 1 18.5 18H7Z"></path>
        </svg>
        Soluciones SaaS
      </a>
      <a href="#outsourcing">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 5h16v5H4zM4 14h16v5H4zM8 7.5h8M8 16.5h8"></path>
        </svg>
        Equipos IT
      </a>
    </nav>

    <Clients />
  </div>
</section>
