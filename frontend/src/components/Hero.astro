---
import { Image } from "astro:assets";
import { brandImages } from "../data/image-assets";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-network" data-hero-motion aria-hidden="true">
    <svg viewBox="0 0 1600 760" width="1600" height="760" focusable="false">
      <path
        data-circuit-path="upper"
        class="hero-circuit-path"
        d="M 50 155 H 230 L 330 255 H 500 L 620 375 H 980 L 1100 255 H 1270 L 1370 155 H 1550"
      ></path>
      <path
        data-circuit-path="middle"
        class="hero-circuit-path"
        d="M 0 410 H 260 L 360 510 H 520 L 650 380 H 950 L 1080 510 H 1240 L 1340 410 H 1600"
      ></path>
      <path
        data-circuit-path="lower"
        class="hero-circuit-path"
        d="M 100 720 H 280 L 400 600 H 540 L 680 460 H 920 L 1060 600 H 1200 L 1320 720 H 1500"
      ></path>
      <path
        data-circuit-path="crown"
        class="hero-circuit-path"
        d="M 340 0 V 110 L 480 250 H 620 L 710 340 H 890 L 980 250 H 1120 L 1260 110 V 0"
      ></path>
    </svg>
    <span
      class="hero-circuit-node"
      data-circuit-node="upper"
      data-duration="20"
      data-delay="-3"
    ></span>
    <span
      class="hero-circuit-node"
      data-circuit-node="upper"
      data-duration="20"
      data-delay="-13"
    ></span>
    <span
      class="hero-circuit-node"
      data-circuit-node="middle"
      data-duration="16"
      data-delay="-7"
    ></span>
    <span
      class="hero-circuit-node"
      data-circuit-node="lower"
      data-duration="22"
      data-delay="-5"
    ></span>
    <span
      class="hero-circuit-node"
      data-circuit-node="crown"
      data-duration="18"
      data-delay="-9"
    ></span>
  </div>

  <div class="container hero-inner">
    <Image
      class="hero-mark"
      src={brandImages.mark.onLight}
      width={116}
      alt=""
      loading="eager"
      decoding="sync"
    />
    <h1 id="hero-title">
      <span>Tecnología que impulsa</span>
      <span>tu crecimiento</span>
    </h1>
    <p class="hero-copy">
      Desarrollo de software, consultoría IT, outsourcing de equipos y soluciones SaaS para
      empresas que quieren ir más lejos.
    </p>

    <div
      class="agent-preview"
      role="group"
      aria-label="Acceso a consultas para el futuro asistente con inteligencia artificial"
      aria-describedby="agent-helper"
    >
      <span class="agent-symbol" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
          <path d="M12 3.5c.7 4.4 2.1 5.8 6.5 6.5-4.4.7-5.8 2.1-6.5 6.5-.7-4.4-2.1-5.8-6.5-6.5 4.4-.7 5.8-2.1 6.5-6.5Z"></path>
          <path d="M18.4 15.8c.3 1.8.9 2.4 2.6 2.7-1.7.3-2.3.9-2.6 2.5-.3-1.6-.9-2.2-2.6-2.5 1.7-.3 2.3-.9 2.6-2.7Z"></path>
        </svg>
      </span>
      <span class="agent-placeholder">Escribí tu consulta para nuestro agente...</span>
      <a class="agent-send" href="#contacto" aria-label="Consultar con un experto de SaltaCode">
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" focusable="false">
          <path d="m4 5 16-2-6.8 17-2.4-6.8L4 10.5 4 5Zm7.2 6.3 5-5.1-8.8 2 4 1.6-.2 1.5Z"></path>
        </svg>
      </a>
    </div>
    <p class="agent-helper" id="agent-helper">
      Nuestro agente IA responderá al instante sobre servicios, procesos, tecnologías y cómo
      podemos ayudarte.
    </p>

    <nav class="quick-links" aria-label="Accesos rápidos a servicios">
      <a href="#software-factory">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"></path>
        </svg>
        Software a medida
      </a>
      <a href="#consultoria-it">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM2 21v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2M16 8h6M19 5v6M17 14h3a3 3 0 0 1 3 3v4"></path>
        </svg>
        Consultoría IT
      </a>
      <a href="#soluciones-saas">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7 18H5a4 4 0 0 1-.4-8A7 7 0 0 1 18 8.5 4.8 4.8 0 0 1 1 9.5A4.3 4.3 0 0 1 18.5 18H7Z"></path>
        </svg>
        Soluciones SaaS
      </a>
      <a href="#outsourcing">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 5h16v5H4zM4 14h16v5H4zM8 7.5h8M8 16.5h8"></path>
        </svg>
        Equipos IT
      </a>
    </nav>

    <ul class="service-summary" aria-label="Principales servicios">
      <li>
        <span aria-hidden="true">01</span>
        <strong>Software a medida</strong>
        <p>Web, mobile y sistemas escalables.</p>
        <a href="#software-factory" aria-label="Conocer Software a medida">Conocer más</a>
      </li>
      <li>
        <span aria-hidden="true">02</span>
        <strong>Consultoría IT</strong>
        <p>Arquitectura, estrategia y buenas prácticas.</p>
        <a href="#consultoria-it" aria-label="Conocer Consultoría IT">Conocer más</a>
      </li>
      <li>
        <span aria-hidden="true">03</span>
        <strong>Soluciones SaaS</strong>
        <p>Productos digitales listos para crecer.</p>
        <a href="#soluciones-saas" aria-label="Conocer Soluciones SaaS">Conocer más</a>
      </li>
      <li>
        <span aria-hidden="true">04</span>
        <strong>Equipos IT</strong>
        <p>Talento técnico para proyectos de alto impacto.</p>
        <a href="#outsourcing" aria-label="Conocer Equipos IT">Conocer más</a>
      </li>
    </ul>
  </div>
</section>

<script>
  const motionRoot = document.querySelector<HTMLElement>("[data-hero-motion]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (motionRoot && !reducedMotion.matches) {
    const startMotion = async () => {
      if (!motionRoot.isConnected || reducedMotion.matches) return;
      const { startHeroMotion } = await import("../scripts/hero-motion");
      if (!reducedMotion.matches) startHeroMotion(motionRoot);
    };

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(startMotion, { timeout: 1_200 });
    } else {
      globalThis.setTimeout(startMotion, 0);
    }
  }
</script>
