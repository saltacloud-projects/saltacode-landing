---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Desarrollo de software a medida en Salta | SaltaCode";
const description =
  "Creamos software a medida, integramos sistemas y sumamos equipos IT para empresas. Consultoría y soluciones SaaS desde Salta, Argentina.";
---

<BaseLayout title={title} description={description}>
  <div id="top"></div>
  <Header revealOnScroll />
  <main id="contenido">
    <Hero />
    <Services />
    <About />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<script>
  import "../scripts/page-motion";
</script>
