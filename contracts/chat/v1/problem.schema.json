{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Code",
      "type": "string"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "detail": {
      "title": "Detail",
      "type": "string"
    },
    "status": {
      "maximum": 599,
      "minimum": 400,
      "title": "Status",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "type": {
      "default": "about:blank",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "code",
    "detail",
    "correlation_id"
  ],
  "title": "ProblemDetails",
  "type": "object"
}
