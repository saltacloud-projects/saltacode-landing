{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "privacy_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Privacy Version",
      "type": "string"
    },
    "transcript_consent": {
      "const": true,
      "title": "Transcript Consent",
      "type": "boolean"
    }
  },
  "required": [
    "transcript_consent",
    "privacy_version"
  ],
  "title": "BrowserResetRequest",
  "type": "object"
}
