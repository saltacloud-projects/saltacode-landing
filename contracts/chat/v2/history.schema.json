{
  "$defs": {
    "ChatActivity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "queued",
            "running"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ChatActivity",
      "type": "object"
    },
    "ChatPresence": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "$ref": "#/$defs/TypingState"
        }
      },
      "title": "ChatPresence",
      "type": "object"
    },
    "HistoryMessage": {
      "additionalProperties": false,
      "properties": {
        "author_type": {
          "default": "unknown",
          "enum": [
            "visitor",
            "agent",
            "operator",
            "system",
            "unknown"
          ],
          "title": "Author Type",
          "type": "string"
        },
        "client_message_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Client Message Id",
          "type": "string"
        },
        "content": {
          "maxLength": 16000,
          "title": "Content",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "client_message_id",
        "role",
        "content",
        "status",
        "created_at"
      ],
      "title": "HistoryMessage",
      "type": "object"
    },
    "TypingState": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "typing": {
          "default": false,
          "title": "Typing",
          "type": "boolean"
        }
      },
      "title": "TypingState",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatActivity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "control_mode": {
      "enum": [
        "automated",
        "paused",
        "human",
        "closed"
      ],
      "title": "Control Mode",
      "type": "string"
    },
    "latest_event_id": {
      "minimum": 0,
      "title": "Latest Event Id",
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/HistoryMessage"
      },
      "title": "Messages",
      "type": "array"
    },
    "presence": {
      "$ref": "#/$defs/ChatPresence"
    },
    "status": {
      "enum": [
        "active",
        "closed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "control_mode",
    "latest_event_id",
    "messages"
  ],
  "title": "HistoryResponse",
  "type": "object"
}
