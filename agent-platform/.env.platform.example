APP_VERSION=dev
FASTAPI_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=generate-a-strong-local-secret
REDIS_MAX_MEMORY=256mb
JWT_SECRET_KEY=generate-at-least-32-random-characters
ADMIN_INITIAL_EMAIL=admin@local.saltacode.com
ADMIN_INITIAL_PASSWORD=generate-at-least-12-random-characters
ADMIN_FRONTEND_URL=http://localhost:23000
DEFAULT_AGENT_SLUG=saltacode
RETENTION_SWEEP_INTERVAL_SECONDS=21600
DOMAIN=localhost
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_API_BIND_ADDRESS=0.0.0.0
AGENT_API_PORT=28082
AGENT_PANEL_BIND_ADDRESS=0.0.0.0
AGENT_PANEL_PORT=23000
