# Non-secret local sandbox interpolation.
SALTACODE_RELEASE=sandbox
SALTACODE_FRONTEND_BIND_ADDRESS=127.0.0.1
SALTACODE_FRONTEND_PORT=28080
SALTACODE_BACKEND_BIND_ADDRESS=127.0.0.1
SALTACODE_BACKEND_PORT=28081
# Keep sandbox on its established, non-production network range.
SALTACODE_FRONTEND_BACKEND_SUBNET=10.248.242.32/28
SALTACODE_RATE_LIMIT_SUBNET=10.248.242.48/28
SALTACODE_INGRESS_SUBNET=10.248.242.64/28
SALTACODE_APP_ENV=development
SALTACODE_ALLOWED_ORIGINS=http://localhost:28080,http://127.0.0.1:28080
# Path only; never put the token value in this file.
SALTACODE_AGENT_INTERNAL_TOKEN_SOURCE_FILE=/etc/saltacode/secrets/agent-internal-token-sandbox
SALTACODE_SESSION_SIGNING_SECRET_SOURCE_FILE=/etc/saltacode/secrets/session-signing-secret-sandbox
# Numeric group owning both mode-0640 secret files.
SALTACODE_SECRET_GID=1000
# Persisted public web route configured in the agent platform.
SALTACODE_AGENT_ROUTE_KEY=saltacode-landing
SALTACODE_RATE_LIMIT_BACKEND=redis
SALTACODE_REDIS_URL=redis://redis:6379/0
# Sandbox also pins the image used by its integration checks.
SALTACODE_REDIS_IMAGE=redis:7.4-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
SALTACODE_REDIS_UID=999
SALTACODE_REDIS_GID=999
SALTACODE_RATE_LIMIT_REQUESTS=100
SALTACODE_RATE_LIMIT_WINDOW_SECONDS=60
