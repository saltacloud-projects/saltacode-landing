# Non-secret Compose interpolation. Copy outside the repository before use.
SALTACODE_RELEASE=REPLACE_WITH_IMMUTABLE_RELEASE
SALTACODE_FRONTEND_BIND_ADDRESS=127.0.0.1
SALTACODE_FRONTEND_PORT=18080
SALTACODE_BACKEND_BIND_ADDRESS=127.0.0.1
SALTACODE_BACKEND_PORT=18081
SALTACODE_APP_ENV=production
SALTACODE_ALLOWED_ORIGINS=https://saltacode.com.ar
# Path only; the file must contain a unique 32+ character token and stay outside Git.
SALTACODE_AGENT_INTERNAL_TOKEN_SOURCE_FILE=/etc/saltacode/secrets/agent-internal-token
SALTACODE_SESSION_SIGNING_SECRET_SOURCE_FILE=/etc/saltacode/secrets/session-signing-secret
# Numeric GID of the dedicated group owning both mode-0640 secret files.
SALTACODE_SECRET_GID=REPLACE_WITH_NUMERIC_SECRET_GROUP_GID
# Persisted public web route configured in the agent platform.
SALTACODE_AGENT_ROUTE_KEY=saltacode-landing
SALTACODE_RATE_LIMIT_BACKEND=redis
SALTACODE_REDIS_URL=redis://redis:6379/0
# Must include a real sha256 digest before preflight can pass.
SALTACODE_REDIS_IMAGE=redis:7.4-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
SALTACODE_REDIS_UID=999
SALTACODE_REDIS_GID=999
SALTACODE_RATE_LIMIT_REQUESTS=20
SALTACODE_RATE_LIMIT_WINDOW_SECONDS=60
